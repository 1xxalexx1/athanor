  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6d583c",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#444d0f"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp"
      ],
      "settings": {
        "foreground": "#245239"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant",
        "variable.other.enummember",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#812a3d"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#911700"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#6d583c"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#911700"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#654100"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#664100"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#245239"
      }
    },
    {
      "scope": [
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#245239"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property",
        "variable.other.object.property",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1f1914"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.other.predefined"
      ],
      "settings": {
        "foreground": "#664100"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "#2b4a71"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "meta.attribute",
        "storage.type.annotation",
        "entity.name.function.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#2b4a71"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#911700"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#2b4a71"
      }
    },
    {
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#664100"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#911700",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#654100",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#812a3d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold"
      ],
      "settings": {
        "foreground": "#812a3d",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#6d583c",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "string.other.link",
        "meta.link.reference.def entity.name"
      ],
      "settings": {
        "foreground": "#2b4a71"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#245239",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#444d0f"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#6d583c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation.definition.list.begin",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#245239"
      }
    },
    {
      "scope": [
        "meta.separator"
      ],
      "settings": {
        "foreground": "#6d583c"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#444d0f"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#911700"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#664100"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#911700",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#2b4a71",
    "class": "#245239",
    "struct": "#245239",
    "enum": "#245239",
    "interface": "#245239",
